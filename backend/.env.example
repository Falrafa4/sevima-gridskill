# Application
APP_NAME="GridSkill Backend API"
APP_VERSION="1.0.0"
ENVIRONMENT="development"
APP_HOST="0.0.0.0"
APP_PORT=8000
CORS_ORIGINS="*"

# Database (Supabase PostgreSQL)
# Format: postgresql+psycopg2://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=""

# Supabase direct fallback env keys
DB_HOST=""
DB_USER=""
DB_PASSWORD=""
DB_PORT="5432"
DB_NAME="postgres"

# Supabase BaaS (Optional)
SUPABASE_URL=""
SUPABASE_KEY=""

# Google Gemini AI
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.8-flash"
GEMINI_MODEL_FALLBACKS="gemini-flash-latest,gemini-3.5-flash,gemini-3.5-flash-lite"
